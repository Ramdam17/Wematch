rules_version = '2';

// Wematch social graph (plan 1.2a) — everything requires Firebase Auth (SIWA federated).
// Identity key everywhere: Firebase Auth UID. Recipient semantics enforced per document.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function onlyKeysChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── Profiles ─────────────────────────────────────────────────────────
    // Directory: readable by any signed-in user (username search), writable
    // only by its owner.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Username uniqueness reservations (one doc per username, created in the
    // same batch as the profile).
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Groups ───────────────────────────────────────────────────────────
    // v1 trade-off (documented in README): group docs are readable app-wide
    // (join-by-code and search need it). Membership writes are constrained.
    match /groups/{groupID} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.adminID == request.auth.uid;
      // Admin can update anything; a member may only touch memberIDs
      // (leave = removing themselves; rules keep v1 coarse, app enforces intent).
      allow update: if signedIn() && (
        resource.data.adminID == request.auth.uid ||
        (request.auth.uid in resource.data.memberIDs && onlyKeysChanged(['memberIDs']))
      );
      allow delete: if signedIn() && resource.data.adminID == request.auth.uid;
    }

    match /joinRequests/{requestID} {
      allow create: if signedIn() && request.resource.data.userID == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.userID == request.auth.uid ||
        get(/databases/$(database)/documents/groups/$(resource.data.groupID)).data.adminID == request.auth.uid
      );
      // Accept/decline: group admin. Cancel: requester deletes.
      allow update: if signedIn()
        && get(/databases/$(database)/documents/groups/$(resource.data.groupID)).data.adminID == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.userID == request.auth.uid ||
        get(/databases/$(database)/documents/groups/$(resource.data.groupID)).data.adminID == request.auth.uid
      );
    }

    // ── Friends ──────────────────────────────────────────────────────────
    match /friendRequests/{requestID} {
      allow create: if signedIn() && request.resource.data.senderID == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.senderID == request.auth.uid ||
        resource.data.receiverID == request.auth.uid
      );
      allow update: if signedIn() && resource.data.receiverID == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.senderID == request.auth.uid ||
        resource.data.receiverID == request.auth.uid
      );
    }

    match /friendships/{friendshipID} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.userIDs;
      allow read, delete: if signedIn() && request.auth.uid in resource.data.userIDs;
    }

    // ── Inbox (the pattern CloudKit could not express) ───────────────────
    // Anyone signed-in may DELIVER a message; only the recipient can read,
    // mark read, or delete. Payload is schema-constrained.
    match /inbox/{uid}/messages/{messageID} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['type', 'senderID', 'createdAt', 'isRead'])
        && request.resource.data.senderID == request.auth.uid
        && request.resource.data.isRead == false
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 40;
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && onlyKeysChanged(['isRead']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
